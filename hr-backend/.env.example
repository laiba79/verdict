# Copy this file to .env and adjust values before running the app.

# Secret used to sign JWT tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_string

# JWT algorithm + token lifetime (minutes)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite by default. Swap for a Postgres URL later without changing any code, e.g.:
#   postgresql://user:password@localhost:5432/hr_decision_system
DATABASE_URL=sqlite:///./hr_decision_system.db

# Default admin account created automatically on first startup
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# Allowed origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: powers the in-app "Ask HR Assistant" chatbot using Groq's free
# API (https://console.groq.com/keys -- no credit card required). Leave
# blank to disable the chatbot; everything else in the app works without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
